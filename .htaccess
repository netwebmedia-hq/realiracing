# realiracing.com — sim-racing content + Amazon affiliate site (Don Gastón portfolio)
# Static docroot. No backend.
#
# Added 2026-07-21 after a portfolio audit found the site had NO .htaccess at
# all: http://realiracing.com and https://www.realiracing.com both answered
# 200 alongside the apex, so the same content was reachable at three
# hostnames (split ranking signals, no HSTS, no security headers), and
# directory listing was open (/js/ served a 200 index).

Options -Indexes
DirectoryIndex index.html

# ── Canonical host: www → non-www, and force HTTPS ──────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://realiracing.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.realiracing\.com$ [NC]
  RewriteRule ^ https://realiracing.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Security headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # No 'preload' and no 'includeSubDomains': this domain's subdomain usage
  # isn't audited, and preload is effectively irreversible.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Nothing on this site asks for a device capability; deny them all so an
  # injected script cannot either. Added 2026-09-02 (Site Scorecard "Fix first").
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Enforced CSP (not Report-Only). Audited 2026-08-18 across this repo and the
  # live blog output.
  #
  # script-src carries NO 'unsafe-inline'. 29 blog posts each embed their own
  # <script> calling renderGearBox() with that post's affiliate keys — all
  # different, and the blog machine keeps publishing more — so a hand-written
  # hash list would go stale the first time a post auto-published. Instead
  # `node _deploy/csp-inline-hashes.js` regenerates the sha256 allow-list below
  # from the HTML actually being shipped, and deploy.yml runs it against the
  # staged tree on every deploy. The list therefore cannot drift, and unlike
  # 'unsafe-inline' — which would permit ANY inline script, including one
  # injected at runtime — only inline scripts present in the committed source
  # can execute.
  # index.html and gear.html were cleared of inline script entirely on
  # 2026-08-18 (see js/home.js and js/gear-page.js); the hashes below are the
  # blog's.
  # The JSON-LD blocks are NOT in this list: type="application/ld+json" is a
  # data block the browser never executes, so script-src never applied to them.
  #
  # style-src needs 'unsafe-inline' too — there are 119 style="" attributes and
  # two <style> blocks in the markup. Note this does NOT cover CSSOM: verified
  # in a browser on 2026-08-18 that under style-src without 'unsafe-inline',
  # el.style.cssText and el.style.prop still apply and only
  # setAttribute('style', …) is blocked.
  #
  # img-src: img.youtube.com serves the video thumbnails. The homepage slides
  # are self-hosted under slides/ since 2026-09-02 — the images.pexels.com
  # fallback that used to sit behind them set __cf_bm/_cfuvid third-party
  # cookies and cost Best Practices 27 points, so it is gone from the CSS and
  # from here. js/ga4.js injects gtag at runtime, so googletagmanager needs
  # script-src and the beacon + pixel need connect-src and img-src; miss one and
  # GA4 goes silent while the page looks fine. There are no iframes on this site,
  # so youtube.com/linktr.ee/x.com are anchor hrefs only and need no entry.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/PreoQYKCip0gcNowbt5HxXbh+KHiavWekI/KVK8ZZk=' 'sha256-00fmBtfBMm09ydyu3dHFKJlws+oJs287M9J78do6UQc=' 'sha256-149O7ncNF8sUZtiqVpPJU+1p05totBMGlSxvm2EMn2I=' 'sha256-1t4sfkTknIeWiQwec5/Y8wNhPSKQotSn4pt1U/1h57w=' 'sha256-1vPLH68pVwhkXaU+r/yuw0AOD0/TKa4pU4S4kL0wCcM=' 'sha256-4DCQqTT+1IC0vDNm+8HcCyrtqclPAIt8rr5IcFw8/2E=' 'sha256-4WOCQZQWtlmSEoVtAidr4wOz9JLV9NuNyjVfTpN+P/A=' 'sha256-4tYQgfQh+xkWHnfhWdG1sIFYvYclxzrJlaJP56ncj5A=' 'sha256-7mZgBM/nc8JE1/o6QNyuDWKeu5LfbxAdgqNtaJgz1RI=' 'sha256-7wsaiLPA25Z9InLFYpTH39KYAaaS49wKN4qoHgYWi2c=' 'sha256-8YPbf7B4EsMlh9qpBtU9H2crj9bGNEylg6A9vjdww2I=' 'sha256-9nm4Fo+Rxs1XWVHBBFFe0dXI9mnAKDkEJ2dS9lTujGU=' 'sha256-C4jWy61RdKeCRSSEJ4KcZWTdz8ZNUJjrvT8rtswEP0w=' 'sha256-DvxwlchMA+3VqfUaD83iys3/9aNOUNORdtw6l2JappU=' 'sha256-ESVZuJmUZQ3D6wjXyPLjlmV5XXK6DiEVgSGzJxjdmkw=' 'sha256-H6UPqMghlMak6rO2vcuZxXI2f0M4uXzBdL61GeaCF14=' 'sha256-HRoJflrip0dz2TWqQMgOBU4mcb6vNk/IChHZM1WwCMY=' 'sha256-IOxUxzMn3fC187OWopj0aXv4Heh0HlV4JyfTqM/hXNg=' 'sha256-J/0PJe5YxYBw9EQmQd6kGds5N7jTzTOfSpvkooaaJtM=' 'sha256-J7lvJ80FZyO/F1igX8QVCztXtGhFHfW9Lb8Y8obmA4s=' 'sha256-JiCTyp0/zNO0imwtmeorcRtGJvEX0kgD+Z7crjdBiSk=' 'sha256-O9SmJYwrvqP8vJY+eJG6rxyXyiIyzH/NTtbo/comQdE=' 'sha256-OJ//mb7LRYPYx7ZvUtx3bt3szpe81qnpKBcNLjXkv4k=' 'sha256-Ox0vOi9HGHNhIpYnIfUhmTilpk/Dx+OJX6dtMeoaJqY=' 'sha256-QdA7XMulnMx0tFCG4CUfWSweNj3jCKJjh0YG5sPUaqQ=' 'sha256-S92TyPXSmLz7TP4eJYH6vR0/usnL8x5ADzDZ1AWZ5ms=' 'sha256-SFFFTt8vym4MADi2lrBfser3ISdT5UMN0+KyixerSIM=' 'sha256-T4Mwo4FoyW0Vl9kgsa4bR61V9xMKMfjKZXw9Hjx1u4w=' 'sha256-TR+wNwx6m+1N8RnZ1Yp/VwJs6lYgfv0UV4egxqnFXcE=' 'sha256-TZ8OavTEOqLiOZq3TwVPRQiUkA0JsdcvAchz1ZWGOHQ=' 'sha256-W3IptnClnmh3JGN/dWsKH4N1n3psWo8ucDlHjcA0Utc=' 'sha256-X2kglWSH0P4OhYeryjHdNjSj5w+D92pp3ZdMkUStnNI=' 'sha256-Xkss9feKfX3CqXYU168UqqfTy4Ku8i5jWTm93foXSk4=' 'sha256-Z5ajIOXHsk2k4GIvG5wmo5SXKQJkL9juSbLntCZjfPs=' 'sha256-bKIYeliCSE2iTL4LJj25tkP1FKtGDqDaIjvz6bDl54g=' 'sha256-bZlSTxIhTrlQ/LeL137aNsgwL5WRwKPN+IZRqiPjrnY=' 'sha256-dI3IhG5Z+0Lw3ExMZFQhUZtkpJSRDlry98JrS8HD7rk=' 'sha256-dqbi67scy08xZVMq9CAWRpC+dD5gLNiWESXI/STpf+M=' 'sha256-fN5QTKyUvD+KTPA5RDcAoBVjEzP3CIHm2fPYzpKkA4s=' 'sha256-fRRPBwuipdYZDnhIZrckj2rKcu4r+iM0j0UagvtNrJ0=' 'sha256-gn6pqRXiuYLpfBdkXQpTBfCrxjP92/XQMjol7HL6pR0=' 'sha256-hG2bUIyQefqH9wU0I2eWQvX8pwXooaz0zohbdfqrZWU=' 'sha256-iO6T3hXoNCPyyUF9dDoSUPVt2R0WZi80w8ReAGo7i28=' 'sha256-iz3V8UQWbEe9tUZ3FxWXDjE3fNqLldOJpLzL++JeswQ=' 'sha256-lYLNnyatN07tYRdXnxFMsvPn9f7+Oi38hZ2UhESsBEA=' 'sha256-li+sis39UbEXaQ8LZFtblSTrBKsTjNXQ+ke/IE8Cph4=' 'sha256-n6mRHeOpgnWyuAkLLiMWa1MAhXYinrp1LyVoNFouors=' 'sha256-oQYTgvcnVR7mqn3m7YYpFf1C3J8eiQETHVfaE2Kcwus=' 'sha256-pNM7PHTp2MHHPIpOdvB8+vNos/ieBiJXkrTyQqsPbZk=' 'sha256-pZA0qArnVKarZP5RP2gwrYtzEBxhtu46rjO6wojsfoA=' 'sha256-qzAl/PPeG19fb4ZEJkHaxoMo8xZGgzx/21JbJOxSHSA=' 'sha256-rMsfgAi2VorFzYchrc78vnC70rgt5dQvwPXnAC3zbPA=' 'sha256-tEGO8twQX3cEBz+yHv/O3MYqXP6MvT+jhstN9oXDzmM=' 'sha256-tjFuTZ3xw2x+6O2y7jSffsECN1B8FLiCB7YAEmE+vi0=' 'sha256-u933j+gAPljXiSAV0xyAkZrkvT0TwQ5aXfVTZ5uNqnM=' 'sha256-uBmf1PYegPXr94ETYVm+nzVv9BvPt/auvhOJIS5bmuU=' 'sha256-v+KSvcOGJUwVnjsfQSD/8h0WSdMmlTKemSpM8UflBCA=' 'sha256-vc8DzMRMR+eJJqL2+AQD+HJSZw5u2lU4WcxC3W1R2Pc=' 'sha256-wjN0ZSt1GxBVCXpiDzrXvaCawXqbwjUZOmaT8ocNAdA=' 'sha256-wwNTHTb9ZzvhdTk8y8uaOwRtynKnc0DBRGKEyatQzZI=' 'sha256-xr7WNgcBO7WRavh/FiB1Y3YfIWYRERvs+qRj7W2YCpA=' 'sha256-yIc4h7pp85gjkMRtZ0LHJsT8gQPj33HqFKgNe43A74o=' 'sha256-zB66/TgEcOwBN6rUAhDRRciUa/A9ElVSzr59pdjRFvo=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://img.youtube.com https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://netwebmedia.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; frame-src https://www.youtube-nocookie.com"
</IfModule>

# ── Branded error page ──────────────────────────────────────────────────────
# Without this Apache serves its own 236-byte "Error 404 - Not Found": no
# branding, no nav, no link back, so every stale inbound link is a guaranteed
# bounce. Same pattern already live on dongaston, marpolis and entrepoker.
ErrorDocument 404 /404.html

# ── Caching: HTML always fresh, static assets long-lived ────────────────────
# js/ is deliberately NOT immutable-for-a-year: js/affiliates.js carries the
# Amazon Associates tag and the whole product table, so a tag change has to
# be able to reach existing readers.
#
# css/ moved out of the immutable bucket for exactly the same reason
# (2026-08-25). blog/blog.css is hand-edited in place and every page linked it
# as a bare `blog.css` with no version string, so `immutable` meant a returning
# reader kept the cached copy for a YEAR no matter what shipped. That is how
# the mobile-nav fix (F-01) reached new visitors but not returning ones. The
# pages now carry ?v=20260824 to flush the already-poisoned entries once; this
# header change is what stops the next CSS edit needing a version bump at all.
# Fonts and images stay immutable — they are replaced, not edited in place.
<IfModule mod_headers.c>
  # HTML: 5 minutes + stale-while-revalidate instead of no-cache (competitive
  # report 2026-10-05). The blog machine publishes a few times a day, so a 5 min
  # lag is invisible; repeat views and back/forward navigation stop revalidating.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=3600"
  </FilesMatch>
  # Photos exist as .jpg + .jpg.avif + .jpg.webp (content negotiation below), so
  # caches must key on Accept.
  <FilesMatch "\.(jpe?g|avif|webp)$">
    Header append Vary Accept
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|avif|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ── Modern image formats by content negotiation ─────────────────────────────
# assets/photos/*.jpg and slides/*.jpg each have <name>.jpg.avif and
# <name>.jpg.webp siblings (_deploy/build-photo-variants.py). HTML and CSS keep
# pointing at the .jpg, which stays the universal fallback and the og:image; a
# browser whose Accept header lists AVIF or WebP is answered with the smaller
# file. Roughly half the bytes on every photo, no markup change.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/avif
  RewriteCond %{DOCUMENT_ROOT}/$1.$2.avif -f
  RewriteRule ^((?:assets/photos|slides)/.+)\.(jpe?g)$ $1.$2.avif [T=image/avif,L]
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.$2.webp -f
  RewriteRule ^((?:assets/photos|slides)/.+)\.(jpe?g)$ $1.$2.webp [T=image/webp,L]
</IfModule>

# The FTP deploy action (SamKirkland/FTP-Deploy-Action) writes its sync-state
# file into the docroot: a JSON inventory of every deployed path + hash. It was
# web-readable (sibling property climalerta.com served it 200 on 2026-09-01).
# The action reads it back over FTP, so an HTTP 404 costs deploys nothing.
RedirectMatch 404 (^|/)\.ftp-deploy-sync-state

# Duplicate-title posts removed 2026-11-10 (audit): the older post is kept, the
# newer twin 301s to it so inbound links and indexed URLs keep working.
RedirectMatch 301 ^/blog/consistency-over-pace-spread-wins-races\.html$ https://realiracing.com/blog/consistency-over-pace-lap-time-spread-wins.html
RedirectMatch 301 ^/blog/motion-rigs-cost-benefit-analysis-iracing\.html$ https://realiracing.com/blog/motion-rigs-cost-benefit-sim-racing.html
RedirectMatch 301 ^/blog/pedal-spacing-setup-consistent-braking-technique\.html$ https://realiracing.com/blog/pedal-spacing-angle-consistent-braking.html

# HTML was served as bare "text/html"; say UTF-8 in the header too (the meta tag already does).
AddDefaultCharset UTF-8
